# Copy this file to .env and fill in the values.

# Required — PostgreSQL connection string
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/bahisaathi_db

# Required — secret used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Required for photo scanning — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional (defaults shown)
# GEMINI_MODEL=gemini-2.5-flash
# CORS_ORIGINS=http://localhost:5173
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
# UPLOAD_DIR=uploads
# MAX_UPLOAD_MB=5
# Days before a customer's oldest unpaid entry marks them overdue
# OVERDUE_AFTER_DAYS=30
